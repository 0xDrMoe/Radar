{
  "name": "radar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npx tsc --noEmit && npm run build && node --test tests/*.test.mjs",
    "test:migrations": "wrangler d1 migrations apply radar-test --local --config wrangler.test.jsonc --persist-to .wrangler/migration-tests",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "deploy": "node scripts/check-deploy-env.mjs && npm run build && npm run prerender && npx wrangler deploy",
    "prerender": "node scripts/prerender-deals.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.9",
    "@clerk/localizations": "^4.16.1",
    "@clerk/react": "^6.14.4",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.33.0",
    "next-intl": "^4.14.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.0",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "patch-package": "^8.0.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.148.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "license": "AGPL-3.0-only"
}
