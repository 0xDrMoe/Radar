# Headers for every file in dist/client, however it is reached: the hashed bundles and stylesheets,
# which the asset layer serves by itself without running the Worker, and the icons, og.png, /sw.js
# and the baked sitemap.xml and robots.txt, which run_worker_first sends to the Worker first so it
# can put the scheme and the name right, and which it then hands back from the ASSETS binding
# unchanged (topLevelFile in worker/index.ts). The binding applies these rules to what it returns
# exactly as the asset layer applies them to what it serves. Anything the Worker renders gets its
# headers from withSecurityHeaders in worker/index.ts instead.
#
# vinext writes a _headers file of its own into dist/client, holding only the immutable rule
# below, but only when public/ has none. This file replaces it, so that rule is restated here and
# must stay: without it every hashed bundle is revalidated on every page load.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The icons, the site's share image and the per-deal share cards. Left to the asset layer's default
# (`public, max-age=0, must-revalidate`), each was asked for again on every page view - the browser
# checks its favicon, and /sw.js refetches the ones it keeps - and each of these is routed to the
# Worker first (run_worker_first), so every check was a Worker request answered 304. A day is how
# long a changed icon or a redrawn card may take to show; nothing here changes more often than a
# deploy. Not /sw.js, robots.txt, sitemap.xml or the entry manifest, which must be current.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=86400
/icon-512.png
  Cache-Control: public, max-age=86400
/icon-maskable-512.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
/og/deals/*
  Cache-Control: public, max-age=86400

# Matching worker/index.ts: nosniff on everything, and the same HSTS policy (a browser ignores it
# on a plain-http response, so sending it everywhere is harmless).
/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
